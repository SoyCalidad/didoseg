<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="index" name="Jobs" inherit_id="website_hr_recruitment.index">
        <xpath expr="//h5[@t-if='job.no_of_recruitment &gt;= 1']" position="replace">
            <t t-if="job.is_job_position_closed">
                <h5 t-if="job.no_of_recruitment &gt;= 1">
                    Not available
                </h5>
            </t>
            <t t-else="">
                <h5 t-if="job.no_of_recruitment >= 1" class="text-reset">
                    <span t-field="job.no_of_recruitment"/>
                    <t t-if="job.no_of_recruitment == 1">
                        open position
                    </t>
                    <t t-else="">
                        open positions
                    </t>
                </h5>
            </t>
        </xpath>
        <xpath expr="//div[@t-foreach='jobs']" position="attributes">
            <attribute name="t-att-style">'pointer-events: none;' if job.is_job_position_closed else ''</attribute>
        </xpath>
    </template>
</odoo>
